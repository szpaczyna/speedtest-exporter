{
  "title": "Speedtest",
  "uid": "speedtest",
  "tags": ["speedtest"],
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {"from": "now-7d", "to": "now"},
  "templating": {
    "list": [
      {"name": "datasource", "label": "Datasource", "type": "datasource", "query": "prometheus", "current": {}, "hide": 0}
    ]
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Best download", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "max(max_over_time(speedtest_download_speed_Bps[$__range])) * 8"}]},
    {"id": 2, "type": "stat", "title": "Worst download", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "min(min_over_time(speedtest_download_speed_Bps[$__range])) * 8"}]},
    {"id": 3, "type": "stat", "title": "Best upload", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "max(max_over_time(speedtest_upload_speed_Bps[$__range])) * 8"}]},
    {"id": 4, "type": "stat", "title": "Worst upload", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bps"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "min(min_over_time(speedtest_upload_speed_Bps[$__range])) * 8"}]},
    {"id": 5, "type": "stat", "title": "Best latency", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "min(min_over_time(speedtest_latency_seconds[$__range]))"}]},
    {"id": 6, "type": "stat", "title": "Worst latency", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false,
                  "expr": "max(max_over_time(speedtest_latency_seconds[$__range]))"}]},
    {"id": 7, "type": "timeseries", "title": "Throughput", "gridPos": {"x": 0, "y": 4, "w": 24, "h": 9}, "interval": "15m",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "bps", "custom": {"spanNulls": true}}, "overrides": []},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["min", "max", "mean", "lastNotNull"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Download",
        "expr": "max(last_over_time(speedtest_download_speed_Bps[$__interval])) * 8"},
       {"refId": "B", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Upload",
        "expr": "max(last_over_time(speedtest_upload_speed_Bps[$__interval])) * 8"}]},
    {"id": 8, "type": "timeseries", "title": "Latency", "gridPos": {"x": 0, "y": 13, "w": 12, "h": 8}, "interval": "15m",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": true}}, "overrides": []},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["min", "max", "mean", "lastNotNull"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Latency",
                  "expr": "max(last_over_time(speedtest_latency_seconds[$__interval]))"}]},
    {"id": 9, "type": "timeseries", "title": "Jitter", "gridPos": {"x": 12, "y": 13, "w": 12, "h": 8}, "interval": "15m",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": true}}, "overrides": []},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["min", "max", "mean", "lastNotNull"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Jitter",
                  "expr": "max(last_over_time(speedtest_jitter_seconds[$__interval]))"}]},
    {"id": 10, "type": "timeseries", "title": "Packet loss", "gridPos": {"x": 0, "y": 21, "w": 12, "h": 8}, "interval": "15m",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "custom": {"spanNulls": true}}, "overrides": []},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["min", "max", "mean", "lastNotNull"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Packet loss",
                  "expr": "max(last_over_time(speedtest_packet_loss_ratio[$__interval]))"}]},
    {"id": 11, "type": "timeseries", "title": "Test duration", "gridPos": {"x": 12, "y": 21, "w": 12, "h": 8}, "interval": "15m",
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"spanNulls": true}}, "overrides": []},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["min", "max", "mean", "lastNotNull"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "legendFormat": "Duration",
                  "expr": "max(last_over_time(speedtest_scrape_duration_seconds[$__interval]))"}]},
    {"id": 12, "type": "table", "title": "Last result", "gridPos": {"x": 0, "y": 29, "w": 24, "h": 5},
     "datasource": {"type": "prometheus", "uid": "${datasource}"},
     "fieldConfig": {"defaults": {}, "overrides": [
       {"matcher": {"id": "byName", "options": "Download"}, "properties": [{"id": "unit", "value": "bps"}]},
       {"matcher": {"id": "byName", "options": "Upload"}, "properties": [{"id": "unit", "value": "bps"}]},
       {"matcher": {"id": "byName", "options": "Latency"}, "properties": [{"id": "unit", "value": "s"}]}]},
     "targets": [
       {"refId": "A", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false, "format": "table",
        "expr": "max by (server_name, server_location, server_country, isp) (last_over_time(speedtest_download_speed_Bps[30m])) * 8"},
       {"refId": "B", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false, "format": "table",
        "expr": "max by (server_name, server_location, server_country, isp) (last_over_time(speedtest_upload_speed_Bps[30m])) * 8"},
       {"refId": "C", "datasource": {"type": "prometheus", "uid": "${datasource}"}, "instant": true, "range": false, "format": "table",
        "expr": "max by (server_name, server_location, server_country, isp) (last_over_time(speedtest_latency_seconds[30m]))"}],
     "transformations": [
       {"id": "merge", "options": {}},
       {"id": "organize", "options": {
         "excludeByName": {"Time": true},
         "indexByName": {"server_name": 0, "server_location": 1, "server_country": 2, "isp": 3, "Value #A": 4, "Value #B": 5, "Value #C": 6},
         "renameByName": {"server_name": "Server", "server_location": "Location", "server_country": "Country", "isp": "ISP",
                          "Value #A": "Download", "Value #B": "Upload", "Value #C": "Latency"}}}]}
  ]
}
